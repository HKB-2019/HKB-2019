# Copy to .env and fill in. NEVER commit the real .env.
# Test keys come from your Paystack dashboard under Settings > API Keys.

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Paystack returns the customer after payment. This is the address of the
# /order page: port 3001 with `npm start`, port 5173 with `npm run dev`, and
# your real address once the shop is on a host.
PAYSTACK_CALLBACK_URL=http://localhost:3001/order

# Where the API listens, and where its database file lives.
PORT=3001
DATABASE_PATH=./server/masq.db

# Admin access. Generate both with:  npm run admin:password
# It asks for the password rather than taking it on the command line, where a
# shell history file and `ps` would both see it. Only the hash is ever stored.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

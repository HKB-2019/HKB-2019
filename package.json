{
  "name": "masq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node --env-file-if-exists=.env server/tools/setup.js",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "seed:reset": "node --env-file-if-exists=.env server/seed.js --reset",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "admin:password": "node --env-file-if-exists=.env server/tools/hash-password.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build:preview": "node tools/build-preview.mjs",
    "video": "remotion render video/index.jsx BrandFilm out/brand-film.mp4 --public-dir=video/public --image-format=png --crf=12"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "^0.5.8",
    "canvas-confetti": "^1.9.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "framer-motion": "^13.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@remotion/cli": "4.0.532",
    "@vitejs/plugin-react": "^6.1.1",
    "remotion": "4.0.532",
    "vite": "^8.3.0"
  }
}
